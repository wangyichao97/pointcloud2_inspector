<launch>
  <arg name="topic_name" default="/points_raw" />
  <arg name="print_every_n_msg" default="1" />

  <node pkg="pointcloud2_inspector"
        type="pointcloud2_inspector_node"
        name="pointcloud2_inspector"
        output="screen">
    <param name="topic_name" value="$(arg topic_name)" />
    <param name="print_every_n_msg" value="$(arg print_every_n_msg)" />
  </node>
</launch>
