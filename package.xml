<?xml version="1.0"?>
<package format="3">
  <name>pointcloud2_inspector</name>
  <version>1.0.0</version>
  <description>
    Runtime PointCloud2 layout inspector for ROS1 (Noetic) and ROS2 (Foxy/Humble),
    with configurable topic subscription and print throttling.
  </description>

  <maintainer email="maintainer@example.com">PointCloud2 Inspector Maintainer</maintainer>
  <license>MIT</license>

  <!--
    Single package.xml for dual ROS1/ROS2 support:
    dependency tags are conditionally selected with ROS_VERSION.
  -->
  <buildtool_depend condition="$ROS_VERSION == 1">catkin</buildtool_depend>
  <buildtool_depend condition="$ROS_VERSION == 2">ament_cmake</buildtool_depend>

  <depend condition="$ROS_VERSION == 1">roscpp</depend>
  <depend condition="$ROS_VERSION == 2">rclcpp</depend>

  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>

  <export>
    <build_type condition="$ROS_VERSION == 1">catkin</build_type>
    <build_type condition="$ROS_VERSION == 2">ament_cmake</build_type>
  </export>
</package>
